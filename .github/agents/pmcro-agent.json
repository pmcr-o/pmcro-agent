{
  "apiVersion": "pmcro.dev/v1",
  "kind": "agent",
  "id": "pmcro-agent",
  "independentSurface": true,
  "independentChecker": false,
  "input": [
    "seed",
    "plugin",
    "skill",
    "grantRefs",
    "trailRef",
    "completionCriteria"
  ],
  "output": [
    "artifact",
    "evidence",
    "checkerHandoff",
    "nextSeed"
  ],
  "catalog": ".agents/catalog.json",
  "canonical": ".pmcro",
  "role": "global-orchestrator",
  "agentIsOrchestrator": true
}
