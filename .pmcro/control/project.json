{
  "schema": "pmcro.agent-project/v1",
  "id": "pmcro-agent",
  "description": "PMCR-O control-plane agent for bounded autonomous ORCHESTRATE -> PLAN -> MAKE -> CHECK -> REFLECT cycles.",
  "derivedFrom": "agent-skills-template",
  "template": "agent-skills-template",
  "canonical": ".pmcro",
  "projection": ".agents",
  "hostChain": ".claude/.grok/.cursor/.github -> .agents -> .pmcro",
  "requiredSkillShape": [
    "SKILL.md",
    "agents/",
    "scripts/",
    "references/",
    "assets/",
    "tests/"
  ],
  "autonomousLoop": {
    "enabled": true,
    "questionGate": false,
    "onQuestion": "resolve-from-context-or-halt",
    "phaseOrder": [
      "orchestrate",
      "plan",
      "make",
      "check",
      "reflect"
    ]
  },
  "orchestratorRole": "global-orchestrator",
  "agentIsOrchestrator": true,
  "repositoryTemplate": true,
  "outerLoop": "after checker-verified completion, reflect a marketplace-extension seed and start a new cycle when validated gaps remain"
}
