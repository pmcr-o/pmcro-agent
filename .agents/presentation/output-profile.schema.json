{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmcro.ai/schemas/output-profile/v1",
  "title": "PMCR-O Output Profile",
  "description": "Provider-neutral presentation profile. It may shape rendering, never authority or execution semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "pmcro.ai/v1" },
    "kind": { "const": "OutputProfile" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "verbosity", "format", "styleRules", "semanticInvariants"],
      "properties": {
        "audience": { "type": "string", "minLength": 1 },
        "verbosity": { "enum": ["concise", "balanced", "detailed"] },
        "format": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preferred", "headings", "tables", "codeBlocks"],
          "properties": {
            "preferred": { "enum": ["markdown", "plain-text", "json"] },
            "headings": { "type": "boolean" },
            "tables": { "type": "boolean" },
            "codeBlocks": { "type": "boolean" }
          }
        },
        "sections": { "type": "array", "items": { "type": "string" } },
        "styleRules": { "type": "array", "items": { "type": "string" } },
        "semanticInvariants": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mayChangeAuthority",
            "mayChangeApproval",
            "mayChangeLifecycleVerdict",
            "mayOmitRequiredEvidence",
            "mayInventExecution"
          ],
          "properties": {
            "mayChangeAuthority": { "const": false },
            "mayChangeApproval": { "const": false },
            "mayChangeLifecycleVerdict": { "const": false },
            "mayOmitRequiredEvidence": { "const": false },
            "mayInventExecution": { "const": false }
          }
        },
        "hostProjectionHints": {
          "type": "object",
          "description": "Optional renderer hints. These never define profile semantics.",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
