{
  "apiVersion": "pmcro.dev/v1",
  "kind": "agent.index",
  "agent": "pmcro-agent",
  "entries": [
    {
      "route": "@pmcro-agent /pmcro:check",
      "plugin": "pmcro",
      "skill": "check",
      "description": "Check an artifact against acceptance criteria and return one verdict.",
      "path": ".pmcro/plugins/pmcro/skills/check"
    },
    {
      "route": "@pmcro-agent /pmcro:make",
      "plugin": "pmcro",
      "skill": "make",
      "description": "Make one accepted plan inside its declared target. Never issue a verdict.",
      "path": ".pmcro/plugins/pmcro/skills/make"
    },
    {
      "route": "@pmcro-agent /pmcro:plan",
      "plugin": "pmcro",
      "skill": "plan",
      "description": "Plan the minimum PMCR-O work from a seed and a plugin. Read-only.",
      "path": ".pmcro/plugins/pmcro/skills/plan"
    },
    {
      "route": "@pmcro-agent /pmcro:reflect",
      "plugin": "pmcro",
      "skill": "reflect",
      "description": "Record one earned constraint and one unexecuted next seed.",
      "path": ".pmcro/plugins/pmcro/skills/reflect"
    },
    {
      "route": "@pmcro-agent /pmcro-checker:check",
      "plugin": "pmcro-checker",
      "skill": "check",
      "description": "Check an artifact against acceptance criteria and return one verdict.",
      "path": ".pmcro/plugins/pmcro-checker/skills/check"
    },
    {
      "route": "@pmcro-agent /pmcro-governance:govern",
      "plugin": "pmcro-governance",
      "skill": "govern",
      "description": "Keep PMCR-O workflow YAML separate from an ACS manifest. Refuse synthesized policy.",
      "path": ".pmcro/plugins/pmcro-governance/skills/govern"
    },
    {
      "route": "@pmcro-agent /pmcro-maker:make",
      "plugin": "pmcro-maker",
      "skill": "make",
      "description": "Make one accepted plan inside its declared target. Never issue a verdict.",
      "path": ".pmcro/plugins/pmcro-maker/skills/make"
    },
    {
      "route": "@pmcro-agent /pmcro-orchestrator:orchestrate",
      "plugin": "pmcro-orchestrator",
      "skill": "orchestrate",
      "description": "Accept or deny a seed, then route a bounded cycle through registered plugin capabilities.",
      "path": ".pmcro/plugins/pmcro-orchestrator/skills/orchestrate"
    },
    {
      "route": "@pmcro-agent /pmcro-planner:plan",
      "plugin": "pmcro-planner",
      "skill": "plan",
      "description": "Plan the minimum PMCR-O work from a seed and a plugin. Read-only.",
      "path": ".pmcro/plugins/pmcro-planner/skills/plan"
    },
    {
      "route": "@pmcro-agent /pmcro-reflector:reflect",
      "plugin": "pmcro-reflector",
      "skill": "reflect",
      "description": "Record one earned constraint and one unexecuted next seed.",
      "path": ".pmcro/plugins/pmcro-reflector/skills/reflect"
    },
    {
      "route": "@pmcro-agent /skill-creator:create-skill",
      "plugin": "skill-creator",
      "skill": "create-skill",
      "description": "Create a candidate marketplace skill package with an agent, scripts, references, assets, and tests. Use when a marketplace needs a new skill. Does not register the candidate.",
      "path": ".pmcro/plugins/skill-creator/skills/create-skill"
    },
    {
      "route": "@pmcro-agent /skill-creator:delete-skill",
      "plugin": "skill-creator",
      "skill": "delete-skill",
      "description": "Delete a candidate skill package. Use when a candidate should be removed. Refuses a skill the catalog lists.",
      "path": ".pmcro/plugins/skill-creator/skills/delete-skill"
    },
    {
      "route": "@pmcro-agent /skill-creator:read-skill",
      "plugin": "skill-creator",
      "skill": "read-skill",
      "description": "Retrieve a skill from the catalog, or from a candidate package. Use to read a skill. Does not register the candidate.",
      "path": ".pmcro/plugins/skill-creator/skills/read-skill"
    },
    {
      "route": "@pmcro-agent /skill-creator:update-skill",
      "plugin": "skill-creator",
      "skill": "update-skill",
      "description": "Update the description of a candidate skill package. Use when a candidate needs a new purpose. Does not change the catalog.",
      "path": ".pmcro/plugins/skill-creator/skills/update-skill"
    }
  ]
}
